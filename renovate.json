{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:org-inherited-config",
    "github>Netcracker/renovate-config:automerge"
  ],
  "enabledManagers": ["github-actions"],
  "includePaths": [".github/workflows/**", "workflow-templates/**"],
  "schedule": ["at any time"],
  "minimumReleaseAge": null,
  "packageRules": [
    {
      "description": "Group updates to Qubership Workflow Hub actions and reusable workflows",
      "matchPackageNames": ["netcracker/qubership-workflow-hub", "netcracker/qubership-workflow-hub/**"],
      "groupName": "qubership-workflow-hub"
    }
  ]
}
